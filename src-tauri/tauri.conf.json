{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Church Presenter",
  "version": "3.3.2",
  "identifier": "com.mbc.churchpresenter",
  "bundle": {
    "fileAssociations": [
      { "ext": ["cpres"], "name": "Church Presenter Service", "description": "Church Presenter service backup", "role": "Editor" }
    ]
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Church Presenter",
        "width": 1450,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/background-media/**"]
      },
      "csp": null
    }
  }
}
